+    kept = " ".join(([header] if header else []) + list(clauses)).lower()
+    kept_words = set(_WORD_RE.findall(kept))
+    if not source_words:
+        return {"ratio": 1.0, "ok": True, "missing_sample": []}
+    missing = sorted(source_words - kept_words)
+    ratio = 1 - len(missing) / len(source_words)
+    return {
