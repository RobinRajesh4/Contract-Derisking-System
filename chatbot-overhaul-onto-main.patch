+                "text": payload.get("text", ""),
+                "analysis_id": payload.get("analysis_id"),
+                "clause_id": payload.get("clause_id"),
+                "kind": payload.get("kind", "clause"),
+                "metadata": payload.get("metadata", {}),
+                "score": score,
+            })
+            if len(output) >= limit:
+                break
         return output
